# Required on Vercel. Backend production/preview HTTPS origin, without /api.
BACKEND_URL=https://your-backend.vercel.app
# Canonical site origin for SEO (canonical URLs, sitemap, social previews).
# Leave empty to fall back to the Vercel deployment URL; set it once a custom
# domain is attached, e.g. https://pckumbambeng.org
NEXT_PUBLIC_SITE_URL=
# Development only. Production browser requests always use same-origin /api.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Optional: api restores the old token-based Facebook feed; otherwise embeds.
FACEBOOK_NEWS_MODE=embed
# Optional: match the backend VAPID public key to enable browser push.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Optional: exercise direct Blob uploads during local development.
NEXT_PUBLIC_USE_BLOB_UPLOADS=false
