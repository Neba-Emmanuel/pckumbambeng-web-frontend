{
    "framework": "vite",
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "rewrites": [
        {
            "source": "/blog/:slug",
            "destination": "/api/blog-og?slug=:slug"
        },
        {
            "source": "/trainings/:slug",
            "destination": "/api/training-og?slug=:slug"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                }
            ]
        }
    ],
    "redirects": [
        {
            "source": "/about-us",
            "destination": "/about",
            "permanent": true
        }
    ]
}
